# Copy to .env for local overrides (optional).
# Never put real secrets here.

DATABASE_URL=sqlite:///./store_engine.db
APP_NAME=Magic Stores
SECRET_KEY=YOUR_SECRET_KEY_HERE
# Set true behind HTTPS so the session cookie gets the Secure flag.
SESSION_HTTPS_ONLY=false
# Dev-only admin seeded on startup when missing (dummy credentials).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
# Separate static content app (../magic_stores_content). Image values "/content/<slug>/<file>"
# are shown from this base. Empty = keep them relative to this site.
CONTENT_BASE_URL=http://127.0.0.1:8001
# Folder the content app serves (its CONTENT_DIR). Importing a pack from its folder publishes the
# pack's media/ files to CONTENT_ROOT/<store-slug>/. Default: ../magic_stores_content/content
# (absolute path, computed from this project). Empty = don't publish media.
# CONTENT_ROOT=/path/to/magic_stores_content/content
# Store packs loaded at startup when their store doesn't exist yet (comma-separated; relative to this
# project). Default: the solares pack. Empty = start with an empty catalog.
# SEED_PACKS=fixtures/packs/solares/solares.store-pack.v1.json
# Secret the payment terminals sign their succeed / fail callbacks with (HMAC-SHA256, at least 32
# characters; generate one with: python3 -c 'import secrets; print(secrets.token_hex(32))').
# Empty = payment callbacks are refused. Never commit the real value.
# PAYMENT_CALLBACK_SECRET=
# Minutes an open cart line keeps its price / name / SKU snapshot before it is checked again
# (repriced, quantity checked against the stock). 0 = check on every request. Default 30.
# CART_REVALIDATE_MINUTES=30
